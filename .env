# These files are loaded in order if they exist.
# Later files override values from earlier files.

# Default environment variables for the application.
# This file is usually committed to version control.
# Example: .env
#
# Local overrides for development machines.
# This file should NOT be committed.
# Example: .env.local
#
# Environment-specific configuration values.
# Loaded depending on APP_ENV value.
# Example: .env.prod or .env.dev
#
# Local environment-specific overrides.
# Usually ignored by Git.
# Example: .env.prod.local

# System environment variables always take priority
# over values defined inside .env files.

# Never store sensitive production secrets in committed files.
# Symfony secrets documentation:
# https://symfony.com/doc/current/configuration/secrets.html

# Compile environment variables for optimized production use.
# Requires symfony/flex version 1.2 or higher.
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration


# Main MySQL database name used by the application.
MYSQL_DATABASE=railway

# Root password for the MySQL database server.
MYSQL_ROOT_PASSWORD=POcWPyyzKYQQVqqDcJytvWtWnVTWwRvB

# Full MySQL database connection URL.
MYSQL_URL=mysql://root:POcWPyyzKYQQVqqDcJytvWtWnVTWwRvB@mysql.railway.internal:3306/railway

# Alternative variable name for the database name.
MYSQLDATABASE=railway

# Hostname or address of the MySQL server.
MYSQLHOST=mysql.railway.internal

# Password used for connecting to MySQL.
MYSQLPASSWORD=POcWPyyzKYQQVqqDcJytvWtWnVTWwRvB

# Port number used by the MySQL service.
MYSQLPORT=3306

# Username used for MySQL authentication.
MYSQLUSER=root


###> symfony/framework-bundle ###

# Defines the Symfony application environment.
# "prod" means production mode.
APP_ENV=prod

# Secret key used for security-related features.
APP_SECRET=12345

# Shared storage directory used by Symfony.
APP_SHARE_DIR=var/share

###< symfony/framework-bundle ###


###> symfony/routing ###

# Base URL used when generating links outside HTTP requests.
# Commonly used in CLI commands or background jobs.
DEFAULT_URI=http://localhost

###< symfony/routing ###


###> doctrine/doctrine-bundle ###

# Doctrine database connection URL.
# Uses MySQL database hosted on Railway.
DATABASE_URL=mysql://root:POcWPyyzKYQQVqqDcJytvWtWnVTWwRvB@mysql.railway.internal:3306/railway

# Example PostgreSQL configuration (disabled).
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"

###< doctrine/doctrine-bundle ###


###> symfony/messenger ###

# Messenger transport configuration.
# Uses Doctrine database transport.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

###< symfony/messenger ###


###> symfony/mailer ###

# Mailer configuration.
# "null://null" disables email sending.
MAILER_DSN=null://null

###< symfony/mailer ###